  "definitions": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "Full name of the person or organisation, in `family, given` order for a person.",
          "type": "string"
        },
        "affiliation": {
          "description": "Affiliation of the person for the purpose of this specific record.",
          "type": "string"
        },
        "orcid": {
          "description": "ORCID identifier of the person, optionally as an `orcid.org` URL, and with the groups of four digits optionally run together. Zenodo normalises the value to the hyphenated form without the prefix. The check digit is not verified here, and an identifier that fails it costs the person their name in the deposit.",
          "type": "string",
          "pattern": "^(?:https?://orcid\\.org/)?(?:\\d{4}[- ]?){3}\\d{3}[0-9Xx]$"
        },
        "gnd": {
          "description": "Gemeinsame Normdatei identifier of the person, optionally prefixed with `gnd:` or a `d-nb.info` URL. A value outside this shape makes the load fail with a server error rather than a message.",
          "type": "string",
          "pattern": "^(?:gnd:|GND:|https?://d-nb\\.info/gnd/|d-nb\\.info/gnd/)?(?:1[012]?\\d{7}[0-9X]|[47]\\d{6}-\\d|[1-9]\\d{0,7}-[0-9X]|3\\d{7}[0-9X])$"
        }
      }
    },
    "contributor": {
      "$comment": "Repeats the properties of `person`, because draft-07 evaluates `additionalProperties` against the properties of the same schema object, so composing the two with `allOf` would reject every inherited key.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "Full name of the person or organisation, in `family, given` order for a person.",
          "type": "string"
        },
        "affiliation": {
          "description": "Affiliation of the person for the purpose of this specific record.",
          "type": "string"
        },
        "orcid": {
          "description": "ORCID identifier of the person, optionally as an `orcid.org` URL, and with the groups of four digits optionally run together. Zenodo normalises the value to the hyphenated form without the prefix. The check digit is not verified here, and an identifier that fails it costs the person their name in the deposit.",
          "type": "string",
          "pattern": "^(?:https?://orcid\\.org/)?(?:\\d{4}[- ]?){3}\\d{3}[0-9Xx]$"
        },
        "gnd": {
          "description": "Gemeinsame Normdatei identifier of the person, optionally prefixed with `gnd:` or a `d-nb.info` URL. A value outside this shape makes the load fail with a server error rather than a message.",
          "type": "string",
          "pattern": "^(?:gnd:|GND:|https?://d-nb\\.info/gnd/|d-nb\\.info/gnd/)?(?:1[012]?\\d{7}[0-9X]|[47]\\d{6}-\\d|[1-9]\\d{0,7}-[0-9X]|3\\d{7}[0-9X])$"
        },
        "type": {
          "description": "Role of the contributor. Zenodo lower cases the value before it looks it up, so it also accepts other capitalisations.",
          "type": "string",
          "enum": [
            "Annotator",
            "ContactPerson",
            "DataCollector",
            "DataCurator",
            "DataManager",
            "Distributor",
            "Editor",
