{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/reproducible-reporting/check-zenodo-json/main/check_zenodo_json/zenodo-derived-legacy-deposit.schema.json",
  "title": "Zenodo deposit metadata (.zenodo.json)",
  "description": "Metadata that Zenodo reads from a `.zenodo.json` file in a GitHub repository when it archives a release. Zenodo translates the file with the legacy deserializer in zenodo-rdm (`zenodo_rdm.legacy.deserializers`), which silently drops keys it does not know, so an unrecognised key here is a key Zenodo would ignore.",
  "$comment": "Derived on 2026-08-25 from the loader Zenodo actually runs, zenodo_rdm.legacy.deserializers at zenodo/zenodo-rdm@6386403, with the license vocabulary taken from zenodo/zenodo-rdm legacy/zenodo_legacy/data and the custom field names from zenodo_rdm.custom_fields and invenio_rdm_records.contrib. The resource type, contributor role, relation type and date type vocabularies are taken from what Zenodo has deployed, read on 2026-08-25 from https://zenodo.org/api/vocabularies/{resourcetypes,contributorsroles,relationtypes,datetypes}, because zenodo-rdm overrides only some vocabularies and inherits the rest from whichever invenio-rdm-records fixture its instance was built with, which lags that project's main branch. What becomes of the loaded metadata was read from zenodo_rdm.github.release and invenio_rdm_records.services.github, which build the record when Zenodo archives a GitHub release. That commit was chosen because Zenodo publishes no version endpoint: the InvenioRDM version in the generator meta tag of every page is too coarse to identify a deployment, so the running code can only be bracketed. On 2026-08-25 zenodo.org served a build between v25.2.2 and v25.2.5, read from its frontend bundler and from two behaviours that changed in known releases, and 6386403 is v25.2.5 plus one commit that touches only a deployment script. Nothing this schema derives from moves inside that bracket. sandbox.zenodo.org ran v26.1.0 or later on the same day. Zenodo extends those vocabularies over time, so a value rejected here may have become valid since.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "`load_access` raises \"Unknown access type\" for an embargo without a date.",
      "if": {
        "properties": {
          "access_right": {
            "const": "embargoed"
          }
        },
        "required": [
          "access_right"
        ]
      },
      "then": {
        "required": [
          "embargo_date"
        ]
      }
    },
    {
      "$comment": "`load_access` reads `embargo_date` only in the embargoed branch, so Zenodo drops it otherwise.",
      "if": {
        "required": [
          "embargo_date"
        ]
      },
      "then": {
        "properties": {
          "access_right": {
            "const": "embargoed"
          }
        },
        "required": [
          "access_right"
        ]
      }
    },
    {
      "$comment": "`load_upload_type` reads only `<upload_type>_type`, so Zenodo drops a subtype that does not match, or one without an `upload_type`.",
      "if": {
        "required": [
          "publication_type"
        ]
      },
      "then": {
        "properties": {
          "upload_type": {
            "const": "publication"
          }
        },
        "required": [
          "upload_type"
        ]
      }
    },
    {
      "if": {
        "required": [
          "image_type"
        ]
      },
      "then": {
        "properties": {
          "upload_type": {
            "const": "image"
          }
        },
        "required": [
          "upload_type"
        ]
      }
    },
    {
      "if": {
        "required": [
          "software_type"
        ]
      },
      "then": {
        "properties": {
          "upload_type": {
            "const": "software"
          }
        },
        "required": [
          "upload_type"
        ]
      }
    }
  ],
  "properties": {
    "upload_type": {
      "description": "Type of the deposit. Combined with the matching `*_type` field into a resource type.",
      "type": "string",
      "enum": [
        "dataset",
        "event",
        "image",
        "lesson",
        "model",
        "other",
        "physicalobject",
        "poster",
        "presentation",
        "publication",
        "software",
        "video",
        "workflow"
      ]
    },
    "publication_type": {
      "description": "Subtype, used only when `upload_type` is `publication`.",
      "type": "string",
      "enum": [
        "annotationcollection",
        "article",
        "book",
        "conferencepaper",
        "conferenceproceeding",
        "datamanagementplan",
        "datapaper",
        "deliverable",
        "dissertation",
        "journal",
        "milestone",
        "other",
        "patent",
        "peerreview",
        "preprint",
        "proposal",
        "report",
        "section",
        "softwaredocumentation",
        "standard",
        "taxonomictreatment",
        "technicalnote",
        "workingpaper"
      ]
    },
    "image_type": {
      "description": "Subtype, used only when `upload_type` is `image`.",
      "type": "string",
      "enum": [
        "diagram",
        "drawing",
        "figure",
        "other",
        "photo",
        "plot"
      ]
    },
    "software_type": {
      "description": "Subtype, used only when `upload_type` is `software`.",
      "type": "string",
      "enum": [
        "computationalnotebook"
      ]
    },
    "title": {
      "description": "Title of the deposit.",
      "type": "string"
    },
    "description": {
      "description": "Description of the deposit. A subset of HTML is allowed.",
      "type": "string"
    },
    "creators": {
      "description": "Creators of the deposit, in order of importance.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/person"
      }
    },
    "contributors": {
      "description": "Contributors of the deposit, each with a role.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/contributor"
      }
    },
    "thesis_supervisors": {
      "description": "Supervisors of the thesis, loaded as contributors with the `supervisor` role.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/person"
      }
    },
    "publication_date": {
      "description": "Publication date, as an EDTF level 0 date (`YYYY`, `YYYY-MM` or `YYYY-MM-DD`) or an interval of two such dates. Defaults to the date of the deposit.",
      "type": "string",
      "pattern": "^\\d{4}(?:-(?:(?:0[13578]|1[02])(?:-(?:0[1-9]|[12]\\d|3[01]))?|(?:0[469]|11)(?:-(?:0[1-9]|[12]\\d|30))?|02(?:-(?:0[1-9]|1\\d|2\\d))?))?(?:/\\d{4}(?:-(?:(?:0[13578]|1[02])(?:-(?:0[1-9]|[12]\\d|3[01]))?|(?:0[469]|11)(?:-(?:0[1-9]|[12]\\d|30))?|02(?:-(?:0[1-9]|1\\d|2\\d))?))?)?$"
    },
    "doi": {
      "description": "Digital Object Identifier, when the deposit already has one.",
      "type": "string"
    },
    "version": {
      "description": "Version of the deposit. Free text, but semantic versioning is recommended.",
      "type": "string"
    },
    "language": {
      "description": "Language of the deposit, as a lower case ISO 639-1 or ISO 639-2/3 code. Zenodo passes a three letter code through unchanged and looks a two letter code up by its lower case form, so an upper case code does not resolve to a language.",
      "type": "string",
      "pattern": "^[a-z]{2,3}$"
    },
    "keywords": {
      "description": "Free-form keywords, loaded as subjects.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subjects": {
      "description": "Subjects from a controlled vocabulary.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "term": {
            "description": "Term of the subject.",
            "type": "string"
          },
          "identifier": {
            "description": "Identifier of the subject term.",
            "type": "string"
          },
          "scheme": {
            "description": "Scheme the identifier belongs to.",
            "type": "string"
          }
        }
      }
    },
    "license": {
      "$ref": "#/definitions/license"
    },
    "access_right": {
      "description": "Access right of the deposit.",
      "type": "string",
      "enum": [
        "open",
        "embargoed",
        "restricted",
        "closed"
      ],
      "default": "open"
    },
    "embargo_date": {
      "description": "Date the deposit becomes public. Required when `access_right` is `embargoed`, and read only then.",
      "type": "string",
      "pattern": "^\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2\\d))$"
    },
    "related_identifiers": {
      "description": "Identifiers of related records, each with a relation type.",
      "type": "array",
      "items": {
        "$comment": "`split_identifiers` moves an `isAlternateIdentifier` entry to `alternate_identifiers`, where `load_alternate_identifiers` reads only `identifier`, so a `resource_type` is dropped.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "relation"
        ],
        "if": {
          "properties": {
            "relation": {
              "const": "isAlternateIdentifier"
            }
          },
          "required": [
            "relation"
          ]
        },
        "then": {
          "not": {
            "required": [
              "resource_type"
            ]
          }
        },
        "properties": {
          "identifier": {
            "description": "The related identifier. Its scheme is detected from the value itself.",
            "type": "string"
          },
          "relation": {
            "description": "Relation of this deposit to the related identifier. Zenodo lower cases the value before it looks it up, so it also accepts other capitalisations.",
            "type": "string",
            "enum": [
              "cites",
              "compiles",
              "continues",
              "describes",
              "documents",
              "hasMetadata",
              "hasPart",
              "hasVersion",
              "isAlternateIdentifier",
              "isCitedBy",
              "isCompiledBy",
              "isContinuedBy",
              "isDerivedFrom",
              "isDescribedBy",
              "isDocumentedBy",
              "isIdenticalTo",
              "isMetadataFor",
              "isNewVersionOf",
              "isObsoletedBy",
              "isOriginalFormOf",
              "isOrignialFormOf",
              "isPartOf",
              "isPreviousVersionOf",
              "isPublishedIn",
              "isReferencedBy",
              "isRequiredBy",
              "isReviewedBy",
              "isSourceOf",
              "isSupplementedBy",
              "isSupplementTo",
              "isVariantFormOf",
              "isVersionOf",
              "obsoletes",
              "references",
              "requires",
              "reviews"
            ]
          },
          "resource_type": {
            "description": "Resource type of the related identifier.",
            "type": "string",
            "enum": [
              "dataset",
              "event",
              "image",
              "image-diagram",
              "image-drawing",
              "image-figure",
              "image-other",
              "image-photo",
              "image-plot",
              "lesson",
              "model",
              "other",
              "physicalobject",
              "poster",
              "presentation",
              "publication",
              "publication-annotationcollection",
              "publication-article",
              "publication-book",
              "publication-conferencepaper",
              "publication-conferenceproceeding",
              "publication-datamanagementplan",
              "publication-datapaper",
              "publication-deliverable",
              "publication-dissertation",
              "publication-journal",
              "publication-milestone",
              "publication-other",
              "publication-patent",
              "publication-peerreview",
              "publication-preprint",
              "publication-proposal",
              "publication-report",
              "publication-section",
              "publication-softwaredocumentation",
              "publication-standard",
              "publication-taxonomictreatment",
              "publication-technicalnote",
              "publication-workingpaper",
              "software",
              "software-computationalnotebook",
              "video",
              "workflow"
            ]
          }
        }
      }
    },
    "alternate_identifiers": {
      "description": "Identifiers of this same deposit elsewhere.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier"
        ],
        "properties": {
          "identifier": {
            "description": "The alternate identifier.",
            "type": "string"
          }
        }
      }
    },
    "dates": {
      "description": "Dates relevant to the deposit. At least one of `start` and `end` is required.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "anyOf": [
          {
            "required": [
              "start"
            ]
          },
          {
            "required": [
              "end"
            ]
          }
        ],
        "properties": {
          "type": {
            "description": "Type of the date. Zenodo lower cases the value before it looks it up, so it also accepts other capitalisations.",
            "type": "string",
            "enum": [
              "accepted",
              "available",
              "collected",
              "copyrighted",
              "created",
              "issued",
              "other",
              "submitted",
              "updated",
              "valid",
              "withdrawn"
            ]
          },
          "start": {
            "description": "Start of the date range, or the date itself, as an EDTF level 0 date (`YYYY`, `YYYY-MM` or `YYYY-MM-DD`).",
            "type": "string",
            "pattern": "^\\d{4}(?:-(?:(?:0[13578]|1[02])(?:-(?:0[1-9]|[12]\\d|3[01]))?|(?:0[469]|11)(?:-(?:0[1-9]|[12]\\d|30))?|02(?:-(?:0[1-9]|1\\d|2\\d))?))?$"
          },
          "end": {
            "description": "End of the date range, or the date itself, as an EDTF level 0 date (`YYYY`, `YYYY-MM` or `YYYY-MM-DD`).",
            "type": "string",
            "pattern": "^\\d{4}(?:-(?:(?:0[13578]|1[02])(?:-(?:0[1-9]|[12]\\d|3[01]))?|(?:0[469]|11)(?:-(?:0[1-9]|[12]\\d|30))?|02(?:-(?:0[1-9]|1\\d|2\\d))?))?$"
          },
          "description": {
            "description": "Free-text description of the date.",
            "type": "string"
          }
        }
      }
    },
    "locations": {
      "description": "Locations relevant to the deposit.",
      "type": "array",
      "items": {
        "$comment": "`load_locations` builds the point under `if lat and lon`, so a lone coordinate is dropped.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "place"
        ],
        "dependencies": {
          "lat": [
            "lon"
          ],
          "lon": [
            "lat"
          ]
        },
        "properties": {
          "place": {
            "description": "Name of the place.",
            "type": "string"
          },
          "lat": {
            "description": "Latitude. Required together with `lon`.",
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "description": "Longitude. Required together with `lat`.",
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "description": {
            "description": "Free-text description of the location.",
            "type": "string"
          }
        }
      }
    },
    "references": {
      "description": "Bibliographic references, as free-text strings.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grants": {
      "description": "Funding awards, as `<funder DOI>::<award id>`. A bare award id is read as a European Commission grant.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "description": "Award identifier, optionally prefixed with the funder DOI and `::`.",
            "type": "string"
          }
        }
      }
    },
    "communities": {
      "description": "Communities the deposit is submitted to.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier"
        ],
        "properties": {
          "identifier": {
            "description": "Identifier of the community.",
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "description": "Additional notes, loaded as an extra description.",
      "type": "string"
    },
    "method": {
      "description": "Methodology of the work, loaded as an extra description.",
      "type": "string"
    },
    "custom": {
      "description": "Custom fields, keyed by their namespaced name, such as `dwc:family`.",
      "$comment": "Only the field names and the container type of their values are enumerated. What goes inside is left unconstrained, because the 91 fields carry as many different value schemas. A value of the wrong shape is dropped without a word, so `custom` is the one place where this schema cannot promise that everything it accepts survives. The container type of `obo:RO_0002453` is unknown: no value reached the record in testing.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "ac:associatedSpecimenReference",
          "ac:captureDevice",
          "ac:digitizationDate",
          "ac:physicalSetting",
          "ac:resourceCreationTechnique",
          "ac:subjectOrientation",
          "ac:subjectPart",
          "code:codeRepository",
          "code:developmentStatus",
          "code:programmingLanguage",
          "dc:creator",
          "dc:rightsHolder",
          "dwc:associatedSequences",
          "dwc:basisOfRecord",
          "dwc:catalogNumber",
          "dwc:class",
          "dwc:collectionCode",
          "dwc:country",
          "dwc:countryCode",
          "dwc:county",
          "dwc:datasetID",
          "dwc:dateIdentified",
          "dwc:decimalLatitude",
          "dwc:decimalLongitude",
          "dwc:eventDate",
          "dwc:eventID",
          "dwc:family",
          "dwc:genus",
          "dwc:geodeticDatum",
          "dwc:habitat",
          "dwc:identifiedBy",
          "dwc:individualCount",
          "dwc:institutionCode",
          "dwc:kingdom",
          "dwc:lifeStage",
          "dwc:locality",
          "dwc:locationID",
          "dwc:materialSampleID",
          "dwc:namePublishedInID",
          "dwc:namePublishedInYear",
          "dwc:occurrenceID",
          "dwc:occurrenceStatus",
          "dwc:order",
          "dwc:organismQuantity",
          "dwc:organismQuantityType",
          "dwc:otherCatalogNumbers",
          "dwc:parentEventID",
          "dwc:phylum",
          "dwc:preparations",
          "dwc:recordedBy",
          "dwc:sampleSizeUnit",
          "dwc:sampleSizeValue",
          "dwc:samplingEffort",
          "dwc:samplingProtocol",
          "dwc:scientificName",
          "dwc:scientificNameAuthorship",
          "dwc:scientificNameID",
          "dwc:sex",
          "dwc:specificEpithet",
          "dwc:stateProvince",
          "dwc:taxonID",
          "dwc:taxonRank",
          "dwc:taxonomicStatus",
          "dwc:typeStatus",
          "dwc:verbatimElevation",
          "dwc:verbatimEventDate",
          "gbif-dwc:identifiedByID",
          "gbif-dwc:recordedByID",
          "gbif:DNA_sequence",
          "gbif:ampliconSize",
          "gbif:pcr_primer_forward",
          "gbif:pcr_primer_name_forward",
          "gbif:pcr_primer_name_reverse",
          "gbif:pcr_primer_reverse",
          "imprint:imprint",
          "journal:journal",
          "legacy:communities",
          "legacy:subjects",
          "meeting:meeting",
          "mixs:0000012",
          "mixs:0000013",
          "mixs:0000014",
          "mixs:0000044",
          "mixs:0000045",
          "mixs:0000049",
          "mixs:0000050",
          "mixs:0000058",
          "mixs:0000090",
          "obo:RO_0002453",
          "openbiodiv:TaxonomicConceptLabel",
          "thesis:thesis"
        ]
      },
      "properties": {
        "ac:associatedSpecimenReference": {
          "type": "array"
        },
